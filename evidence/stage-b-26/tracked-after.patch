+:root{--night:#121a18;--deep:#1b2522;--paper:#efe9da;--sage:#d5d8c7;--ink:#1f2723;--muted:#4f5a53;--rust:#8a4024;--brass:#e39a62;--brass-2:#f2b585;--light:#fbf3e2;--line:#a5ab9c;font-family:Arial,Helvetica,sans-serif;color:var(--ink);background:var(--paper);font-synthesis:none;-webkit-text-size-adjust:100%}
